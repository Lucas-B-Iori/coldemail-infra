# =====================================================================
# CONFIGURAÇÕES DO MOTOR COLDMAIL ENGINE (Synapze — sites one-page)
# =====================================================================

# Banco de dados SQLite local
DB_PATH=data/engine.db
TZ_NAME=America/Sao_Paulo

# Chave mestra de criptografia (AES-256-GCM) para senhas de contas (gerar 32 bytes hex)
ENCRYPTION_KEY=sua_chave_hex_de_32_bytes_aqui

# OpenRouter / LLM para IA adaptativa e warm-up
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-sua-chave-openrouter-aqui
LLM_MODEL=deepseek/deepseek-chat
# Fallbacks no OpenRouter (só modelos baratos; GPT/Claude são bloqueados no código)
LLM_FALLBACK_MODELS=deepseek/deepseek-chat,xiaomi/mimo-v2-flash
# ai (padrão) = e-mail único por lead, escrito pela IA a partir do fato_observado; template = sequência fixa (só se escolhido)
COPY_MODE=ai
# Unicidade: Jaccard máximo (shingles de 3 palavras) contra as últimas N copies; acima disso, regera (até N tentativas)
UNIQ_MAX_JACCARD=0.35
UNIQ_MAX_ATTEMPTS=3
UNIQ_COMPARE_LAST=2000
SITE_PRICE=R$1.000

# Transporte das caixas M365: graph (Microsoft Graph sendMail, recomendado) ou smtp (XOAUTH2 legado)
SEND_TRANSPORT=graph
# App no Entra ID (client credentials). Permissões de APLICAÇÃO: Mail.Send (+ Mail.ReadWrite, Calendars.ReadWrite nas próximas fases)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Microsoft 365 OAuth2 legado (IMAP/SMTP XOAUTH2). Se AZURE_* estiver vazio, o Graph usa estes.
M365_TENANT_ID=seu_tenant_id_aqui
M365_CLIENT_ID=seu_client_id_aqui
M365_CLIENT_SECRET=seu_client_secret_aqui

# Sementes Gmail para warm-up (App Passwords — NUNCA commitar valores reais)
SEED_GMAIL_1_USER=
SEED_GMAIL_1_PASS=
SEED_GMAIL_1_NAME=
SEED_GMAIL_2_USER=
SEED_GMAIL_2_PASS=
SEED_GMAIL_2_NAME=

# Rampa de cold (independente do warm-up, que continua rodando). Data no fuso TZ_NAME.
# Limite/dia/caixa = COLD_START_PER_DAY + COLD_STEP * floor(dias desde o início / COLD_STEP_DAYS), até COLD_MAX_PER_DAY
COLD_START_DATE=
COLD_START_PER_DAY=10
COLD_STEP=5
COLD_STEP_DAYS=2
COLD_MAX_PER_DAY=40

# Janela de envio de cold emails (horário comercial)
SEND_WINDOW_START=8
SEND_WINDOW_END=18
SEND_WEEKDAYS_ONLY=true

# Janela de envio de warm-up (teia m365 <-> gmail)
WARMUP_WINDOW_START=8
WARMUP_WINDOW_END=20

# Intervalos de envio (segundos) e jitter
COLD_INTERVAL_MIN_SEC=420
COLD_INTERVAL_MAX_SEC=540
COLD_JITTER_SEC=90

# Assinatura
SIGNATURE_ROLE=
SIGNATURE_PHONE=

# Configurações do Dashboard Web
PORT=3000
# Obrigatórios para o painel; sem ambos, o painel fica indisponível (503).
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
# Apenas bancos novos: habilitar explicitamente depois de configurar as credenciais.
AUTO_SEED_FLEET=false
GMAIL_SEED_1_PASS=
GMAIL_SEED_2_PASS=
# Teto de cold por caixa (warm-up tem seu próprio orçamento).
DAILY_CAP=80
# Backup online diário; snapshots ficam no volume persistente.
BACKUP_DIR=data/backups
# Opcional: destino de alertas configurado pelo operador.
ALERT_WEBHOOK_URL=
